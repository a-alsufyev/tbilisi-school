# Required for the map. Restrict this key to your production domain in the Yandex dashboard.
YANDEX_MAPS_API_KEY="your_key_here"

# Optional. Defaults to 3000.
PORT=3000

# PostgreSQL.
# Local Windows: native Postgres, host 127.0.0.1 (no Docker).
# VPS Compose: app overrides DATABASE_URL to host `db`.
POSTGRES_USER=tbilisi
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tbilisi
# Local Windows: native Postgres. Use 127.0.0.1 (localhost may resolve to IPv6 and fail).
DATABASE_URL=postgres://tbilisi:change_me@127.0.0.1:5432/tbilisi

# Admin panel at /admin. Not linked from the public site.
# Change the password and SESSION_SECRET before production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
SESSION_SECRET=change_me_to_a_long_random_string

# School assistant at /{lang}/assistant. The key stays on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
